# Copy to .env and fill in. Pick ONE provider block.

# Generator for src/synth.py (textbook paraphrases + MCQs). Defaults to MODEL_NAME if unset.
# Open-weight models need no disclosure; a closed API (GPT/Claude/Gemini) is allowed for
# training data only and must be disclosed in the manifest and report (shared-task rule 04).
# The generator has its own endpoint, so the OPENAI_* settings below stay free for evaluation.
# Free Google AI Studio key (https://aistudio.google.com/apikey), with its own quota:
GEN_MODEL=gemma-4-31b-it
GEN_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_API_KEY=AIza...
# Or OpenRouter (often rate-limited on :free models): GEN_MODEL=google/gemma-4-31b-it:free and
# leave GEN_BASE_URL unset to use OPENAI_BASE_URL / OPENAI_API_KEY. GEN_API_KEY overrides any key.

# OpenRouter (https://openrouter.ai/keys)
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=sk-or-...
MODEL_NAME=qwen/qwen-2.5-72b-instruct

# Together AI
# OPENAI_BASE_URL=https://api.together.xyz/v1
# OPENAI_API_KEY=...
# MODEL_NAME=Qwen/Qwen2.5-72B-Instruct-Turbo

# Alibaba Cloud DashScope (international)
# OPENAI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# OPENAI_API_KEY=sk-...
# MODEL_NAME=qwen2.5-72b-instruct

# Your own vLLM server (vllm serve Qwen/Qwen2.5-72B-Instruct-AWQ)
# OPENAI_BASE_URL=http://<gpu-host>:8000/v1
# OPENAI_API_KEY=EMPTY
# MODEL_NAME=Qwen/Qwen2.5-72B-Instruct-AWQ
